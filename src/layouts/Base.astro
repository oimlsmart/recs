---
/**
 * The minisite's base layout — the house shell from the package (one
 * chrome SSOT), fed the site's OWN injected config (TODO.public track
 * 02): the package went machinery-only at 0.2.0, so the brand, the nav
 * model, and the footer content come from src/data/ and thread down
 * through the shell's typed contract. The minisite is public content
 * with no sign-in and no AI surfaces: no services registry, no
 * assistant flag, no internal banner — the shell renders exactly what
 * is injected here and invents nothing.
 */
import Shell from '@oimlsmart/site-shell/chrome/astro/Base.astro'
import { BRAND } from '../data/brand'
import { NAV_MODEL } from '../data/nav-config'
import { FOOTER } from '../data/footer'
import '../styles/app.css'

interface Props {
  /** The page title; omitted on the index, where the brand name is
   *  the whole title. */
  title?: string
  description?: string
}
const { title = '', description } = Astro.props
---

<Shell title={title} description={description} brand={BRAND} nav={NAV_MODEL} footer={FOOTER}>
  <slot />
</Shell>
