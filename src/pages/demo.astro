---
import { Base, MinisiteNav } from '@oimlsmart/site-shell'
import '../styles/app.css'

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Story', href: '/story' },
  { label: 'Docs', href: '/docs' },
  { label: 'Demo', href: '/demo' },
]

const RECS = [
  { id: 'r60', name: 'OIML R 60:2021 — load cells', note: 'The first full model: classification, MPE envelopes, the conformance tests, the R 60-3 forms.' },
  { id: 'r91', name: 'OIML R 91:1990 — radar speed meters', note: 'Speed measurement: the operational envelope and its disturbance tests.' },
  { id: 'r129', name: 'OIML R 129:2000 — multi-dimensional measuring instruments', note: 'Dimensional metrology with multi-axis measurands.' },
  { id: 'r144', name: 'OIML R 144:2013 — continuous gas analyzers', note: 'Per-channel measurands and the sampling-line subsystem.' },
]
---

<Base title="The live models" description="Walk the published SMART Recommendations.">
  <MinisiteNav sections={NAV} base="/recs" />
  <main class="max-w-3xl mx-auto px-6 py-14 docs-body">
    <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3">SMART Recommendations · Demo</p>
    <h1 class="font-serif text-3xl font-semibold text-ink mb-6">The live models</h1>
    <p>Each published Recommendation renders from its model: the terminology, the requirements classes, the conformance tests, the report forms, and the certification workflow that runs on them. Follow one and read the model against the document.</p>

    <ul class="mt-6 space-y-4">
      {RECS.map(r => (
        <li class="border border-rule rounded-lg p-5 bg-paper-raised">
          <a href={`/recs/${r.id}/`} class="text-accent font-semibold no-underline">{r.name}</a>
          <p class="text-sm text-ink-soft mt-1">{r.note}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-ink-soft">The per-Recommendation pages are served by the OIML SMART platform (the private application builds them from the same models). The authoring documentation for building one yourself lives in <a href="/recs/docs/" class="text-accent">the docs section</a>.</p>
  </main>
</Base>
