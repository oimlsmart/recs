---
import Base from '../../layouts/Base.astro'
import { DocsSidebar } from '@oimlsmart/site-shell'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const allDocs = await getCollection('docs')
  return allDocs.map(d => ({ params: { slug: d.id }, props: { doc: d } }))
}

const { doc } = Astro.props
const { Content } = await render(doc)
---

<Base title={doc.data.title ?? doc.id} description={doc.data.description}>
  <div class="max-w-7xl mx-auto px-6 py-10 grid gap-10 lg:grid-cols-[16rem_1fr]">
    <aside><DocsSidebar order={['oiml-rec']} labels={{ 'oiml-rec': 'Authoring Recommendations' }} hrefBase="/recs/docs/" /></aside>
    <main class="docs-body">
      {doc.data.eyebrow && <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3">{doc.data.eyebrow}</p>}
      <h1 class="font-serif text-3xl font-semibold text-ink mb-6">{doc.data.shortTitle ?? doc.data.title ?? doc.id.split('/').pop()}</h1>
      <Content />
    </main>
  </div>
</Base>
